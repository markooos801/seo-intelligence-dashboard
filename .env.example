# AI Provider (optional) — provider-agnostic, no vendor lock-in
# Production default is deterministic (no external API call).
# Set to "openai-compatible" or "hermes" to enable live AI insights via any
# OpenAI-compatible endpoint (Hermes gateway, Nous Portal, OpenCode, Ollama, etc.)
AI_PROVIDER="deterministic"
# Example: AI_PROVIDER="openai-compatible"

# AI_API_URL: OpenAI-compatible chat/completions endpoint (required only if AI_PROVIDER != deterministic)
# Examples:
#   Hermes / Nous Portal:  https://api.nous.mouad.ai/v1
#   Ollama local:          http://localhost:11434/v1
#   OpenCode gateway:      http://localhost:8080/v1
AI_API_URL=""

# AI_API_KEY: Bearer token for the endpoint (if your gateway requires auth)
AI_API_KEY=""

# AI_MODEL: Model ID to request from the endpoint
# Examples: hermes-4-70b, longcat-2.0, nous-hermes-2, gpt-4o-mini
AI_MODEL=""

# Optional: request timeout in ms (default 12000)
# AI_TIMEOUT_MS="12000"

# APP_URL: The URL where this dashboard is hosted (for self-referential links)
APP_URL=""

# PORT: HTTP port (default 3000)
# PORT="3000"
